#!/usr/bin/env bash

eval "$(devenv direnvrc)"
use devenv

repo_root="$(git rev-parse --show-toplevel)"
repo_jj_config="$repo_root/jj-config.toml"

if [[ -n "${JJ_CONFIG:-}" ]]; then
  export JJ_CONFIG="$JJ_CONFIG:$repo_jj_config"
elif [[ -n "${JJ_CONFIG+x}" ]]; then
  export JJ_CONFIG="$repo_jj_config"
else
  jj_config_paths=()

  [[ -d /etc/jj ]] && jj_config_paths+=(/etc/jj)
  [[ -f "$HOME/.jjconfig.toml" ]] && jj_config_paths+=("$HOME/.jjconfig.toml")

  user_jj_config="${XDG_CONFIG_HOME:-$HOME/.config}/jj"
  [[ -d "$user_jj_config" ]] && jj_config_paths+=("$user_jj_config")
  jj_config_paths+=("$repo_jj_config")

  export JJ_CONFIG="$(IFS=:; printf '%s' "${jj_config_paths[*]}")"
fi

unset jj_config_paths repo_jj_config repo_root user_jj_config
