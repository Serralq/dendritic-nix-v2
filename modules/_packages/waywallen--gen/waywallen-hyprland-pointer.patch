+
+fn tracking_target(snap: &Snapshot, tracked_classes: &[String]) -> Option<PointerTarget> {
+    let active = snap.active_addr.as_deref()?;
+    let client = snap.clients.iter().find(|client| {
+        client.address == active
+            && client.mapped
+            && !client.hidden
+            && tracked_classes
+                .iter()
+                .any(|class| class.eq_ignore_ascii_case(&client.class))
+    })?;
+    let monitor = snap.monitors.iter().find(|monitor| {
+        monitor.id == client.monitor && monitor.active_workspace.id == client.workspace.id
+    })?;
+    Some(PointerTarget {
+        display_name: monitor.name.clone(),
+        window_x: client.at[0],
+        window_y: client.at[1],
+        window_width: client.size[0],
+        window_height: client.size[1],
+        monitor_x: monitor.x,
+        monitor_y: monitor.y,
+        scale: monitor.scale,
+    })
+}
+
+fn project_pointer(target: &PointerTarget, x: f64, y: f64) -> Option<(String, f32, f32)> {
+    let inside = x >= target.window_x
+        && y >= target.window_y
+        && x < target.window_x + target.window_width
+        && y < target.window_y + target.window_height;
+    if !inside || target.scale <= 0.0 {
+        return None;
+    }
+    Some((
+        target.display_name.clone(),
+        ((x - target.monitor_x) * target.scale) as f32,
+        ((y - target.monitor_y) * target.scale) as f32,
+    ))
+}
