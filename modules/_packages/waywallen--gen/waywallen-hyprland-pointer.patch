+
+fn pointer_loop(
+    command_socket: PathBuf,
+    target: Arc<Mutex<Option<PointerTarget>>>,
+    commands: CommandSender,
+) {
+    let mut last: Option<(String, f32, f32)> = None;
+    loop {
+        let current_target = target.lock().unwrap().clone();
+        let motion = current_target.and_then(|target| {
+            let cursor = request_json::<CursorPosition>(&command_socket, "cursorpos").ok()?;
+            project_pointer(&target, cursor.x, cursor.y)
+        });
+        match motion {
+            Some((display_name, x, y)) => {
+                let current = (display_name.clone(), x, y);
+                if last.as_ref() != Some(&current) {
+                    commands.send(WatcherCommand::PointerMotion {
+                        display_name,
+                        x,
+                        y,
+                        present: true,
+                    });
+                    last = Some(current);
+                }
+            }
+            None => {
+                if let Some((display_name, _, _)) = last.take() {
+                    commands.send(WatcherCommand::PointerMotion {
+                        display_name,
+                        x: -1.0,
+                        y: -1.0,
+                        present: false,
+                    });
+                }
+            }
+        }
+        thread::sleep(POINTER_POLL_INTERVAL);
+    }
+}
